# Copy this file to .env.local and fill in the values.
# Never commit .env.local.
# Find both values in Supabase: Project Settings -> API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: an email address shown on the privacy page for questions.
NEXT_PUBLIC_CONTACT_EMAIL=

# Telegram login (optional; it stays off until all three are set).
# Create the bot with @BotFather in Telegram. Keep the token and the
# service role key SECRET: set them only in the hosting settings.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in is hidden (students use Telegram). Set to "on" to show the button again.
NEXT_PUBLIC_GOOGLE_LOGIN=
